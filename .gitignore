# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.spec

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/
server/logs/
client/logs/

# Working directories
server_work/
client_work/
temp/
upscaled/
frames/
output/
work/
input/
batches/

# Environment variables
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Configuration (user-specific)
config/local_*.json
config/*_local.json

# Old binary locations (deprecated - use assets/ instead)
# Keep ignoring these to prevent accidental re-addition
server/ffmpeg/
server/realesrgan-ncnn-vulkan/
client/ffmpeg/
client/realesrgan-ncnn-vulkan/
client/windows/ffmpeg/
client/windows/realesrgan-ncnn-vulkan/
client/linux/realesrgan-ncnn-vulkan/

# Assets directory contains all binaries and models
# These are now committed to the repository for easier deployment
# Large files should be managed by Git LFS (see .gitattributes)
# Explicitly allow assets directory
!assets/
!assets/**/

# Still ignore loose executables and DLLs outside assets/
*.exe
*.dll
# But allow them inside assets/
!assets/**/*.exe
!assets/**/*.dll
!assets/**/*.bin
!assets/**/*.param

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Documentation builds
docs/_build/

# Temporary files
*.tmp
*.bak
*.swp

# Database files
*.db
*.sqlite
*.sqlite3

# Certificates and keys (security)
*.pem
*.key
*.crt
*.p12
server_work/encryption_keys/
# UpscalingByNetwork Docker Environment Configuration
# Copy this file to .env and customize the values

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8888
LOG_LEVEL=INFO

# Resource Limits
MAX_CLIENTS=50
BATCH_SIZE=50

# Data Directories (relative to container)
INPUT_DIR=./data/input
OUTPUT_DIR=./data/output
MODELS_DIR=./data/models

# GPU Support (true/false)
GPU_SUPPORT=false

# Processing Configuration
REALESRGAN_MODEL=realesr-animevideov3
SCALE_FACTOR=4
TILE_SIZE=256

# FFmpeg Configuration
FFMPEG_CRF=20
FFMPEG_PRESET=medium
FFMPEG_THREADS=12
AUDIO_BITRATE=192k

# Security
ENCRYPTION_ENABLED=true
SESSION_TIMEOUT=3600

# Performance Tuning
BATCH_ASSIGNMENT_INTERVAL=1
HEARTBEAT_INTERVAL=30
CLIENT_TIMEOUT=300

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Debug Mode (development only)
DEBUG=false

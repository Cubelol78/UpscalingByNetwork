[Unit]
Description=UpscalingByNetwork Distributed Server
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/your-repo/UpscalingByNetwork

[Service]
Type=simple
User=upscaling
Group=upscaling
WorkingDirectory=/opt/upscaling-server
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/upscaling-server/venv/bin/python3 /opt/upscaling-server/server/main.py --daemon --host 0.0.0.0 --port 8888
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=upscaling-server

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/upscaling-server/logs /opt/upscaling-server/output /opt/upscaling-server/server_work /opt/upscaling-server/config
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
PrivateMounts=true

# Resource limits
LimitNOFILE=65536
CPUQuota=200%
MemoryMax=8G
TasksMax=512

[Install]
WantedBy=multi-user.target

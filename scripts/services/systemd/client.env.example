# UpscalingByNetwork Client Environment Configuration
# Copy this file to ~/.upscaling/client.env and customize

# ============================================================================
# Server Connection
# ============================================================================

# Server hostname or IP address
#SERVER_HOST=localhost

# Server port
#SERVER_PORT=8888

# Auto-connect to server on startup
#AUTO_CONNECT=true

# Reconnect automatically on disconnect
#AUTO_RECONNECT=true

# Reconnect delay in seconds
#RECONNECT_DELAY=5

# ============================================================================
# Python Configuration
# ============================================================================

# Ensure Python output is not buffered (important for systemd)
PYTHONUNBUFFERED=1

# Python path (usually set by systemd service)
#PYTHONPATH=/opt/UpscalingByNetwork

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
#LOG_LEVEL=INFO

# Log file path (optional, defaults to ~/.upscaling/logs/client.log)
#LOG_FILE=~/.upscaling/logs/client.log

# ============================================================================
# Processing Configuration
# ============================================================================

# Number of concurrent processing threads
#WORKER_THREADS=2

# Maximum batch size to accept
#MAX_BATCH_SIZE=100

# Temporary working directory
#WORK_DIR=~/.upscaling/work

# Output directory for processed files
#OUTPUT_DIR=~/.upscaling/output

# ============================================================================
# Real-ESRGAN Configuration
# ============================================================================

# Model to use (should match server configuration)
#REALESRGAN_MODEL=realesr-animevideov3

# Use GPU if available (true/false)
#REALESRGAN_GPU=true

# GPU device ID (0, 1, etc. for multi-GPU systems)
#GPU_DEVICE=0

# Tile size for GPU processing (larger = more VRAM but faster)
#TILE_SIZE=0

# ============================================================================
# Security Configuration
# ============================================================================

# Authentication token (if server requires auth)
#AUTH_TOKEN=your-secret-token-here

# Enable SSL/TLS connection
#ENABLE_SSL=false

# SSL certificate verification
#SSL_VERIFY=true

# ============================================================================
# Performance Configuration
# ============================================================================

# CPU priority (-20 to 19, lower = higher priority)
#NICE_LEVEL=10

# I/O priority (idle, best-effort, realtime)
#IONICE_CLASS=best-effort

# I/O priority level (0-7, lower = higher priority)
#IONICE_LEVEL=4

# Maximum CPU usage percentage (0-100)
#MAX_CPU_PERCENT=80

# Maximum memory usage in MB
#MAX_MEMORY_MB=4096

# ============================================================================
# Monitoring
# ============================================================================

# Report statistics interval in seconds
#STATS_INTERVAL=60

# Enable performance monitoring
#ENABLE_MONITORING=true

# ============================================================================
# Advanced Options
# ============================================================================

# Timeout for receiving jobs in seconds
#JOB_TIMEOUT=300

# Timeout for processing jobs in seconds
#PROCESSING_TIMEOUT=3600

# Number of retries for failed jobs
#MAX_RETRIES=3

# Retry delay in seconds
#RETRY_DELAY=10

# ============================================================================
# Custom Environment Variables
# ============================================================================

# Add your custom environment variables below
# They will be available to the client process

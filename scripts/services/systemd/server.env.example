# UpscalingByNetwork Server Environment Configuration
# Copy this file to /etc/upscaling/server.env and customize

# ============================================================================
# Server Configuration
# ============================================================================

# Server bind address (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
#SERVER_HOST=0.0.0.0

# Server port
#SERVER_PORT=8888

# ============================================================================
# Python Configuration
# ============================================================================

# Ensure Python output is not buffered (important for systemd)
PYTHONUNBUFFERED=1

# Python path (usually set by systemd service)
#PYTHONPATH=/opt/UpscalingByNetwork

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
#LOG_LEVEL=INFO

# Log file path (optional, defaults to server/logs/server.log)
#LOG_FILE=/var/log/upscaling/server.log

# ============================================================================
# Processing Configuration
# ============================================================================

# Maximum number of concurrent clients
#MAX_CLIENTS=50

# Batch size for processing
#BATCH_SIZE=50

# Maximum retries for failed jobs
#MAX_RETRIES=3

# Server can process jobs itself (true/false)
#SERVER_CAN_PROCESS=true

# Cleanup temporary files after processing
#CLEANUP_TEMP_FILES=true

# ============================================================================
# Real-ESRGAN Configuration
# ============================================================================

# Model to use (realesr-animevideov3, realesrgan-x4plus, realesrgan-x4plus-anime)
#REALESRGAN_MODEL=realesr-animevideov3

# Upscaling factor (2, 4)
#REALESRGAN_SCALE=4

# Use GPU if available (true/false)
#REALESRGAN_GPU=true

# GPU device ID (0, 1, etc. for multi-GPU systems)
#GPU_DEVICE=0

# ============================================================================
# Security Configuration
# ============================================================================

# Enable client authentication (true/false)
#ENABLE_AUTH=false

# Authentication token (set this if ENABLE_AUTH=true)
#AUTH_TOKEN=your-secret-token-here

# Enable SSL/TLS (requires certificate)
#ENABLE_SSL=false

# SSL certificate file
#SSL_CERT=/etc/upscaling/cert.pem

# SSL key file
#SSL_KEY=/etc/upscaling/key.pem

# ============================================================================
# Network Configuration
# ============================================================================

# Heartbeat interval in seconds
#HEARTBEAT_INTERVAL=30

# Client timeout in seconds
#CLIENT_TIMEOUT=120

# Maximum message size in MB
#MAX_MESSAGE_SIZE=100

# ============================================================================
# Performance Tuning
# ============================================================================

# Number of worker threads
#WORKER_THREADS=4

# Enable performance profiling
#ENABLE_PROFILING=false

# ============================================================================
# Monitoring
# ============================================================================

# Enable Prometheus metrics export
#ENABLE_METRICS=false

# Metrics port
#METRICS_PORT=9090

# ============================================================================
# Custom Environment Variables
# ============================================================================

# Add your custom environment variables below
# They will be available to the server process

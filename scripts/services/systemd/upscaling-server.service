[Unit]
Description=UpscalingByNetwork Server - Distributed Video Upscaling Server
Documentation=https://github.com/yourusername/UpscalingByNetwork
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=upscaling
Group=upscaling
WorkingDirectory=/opt/UpscalingByNetwork

# Server execution command (console mode for systemd)
ExecStart=/usr/bin/python3 /opt/UpscalingByNetwork/server/main.py --no-gui --host 0.0.0.0 --port 8888 --log-level INFO
ExecReload=/bin/kill -HUP $MAINPID

# Graceful shutdown with timeout
ExecStop=/bin/kill -SIGTERM $MAINPID
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# Environment variables
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/opt/UpscalingByNetwork"
EnvironmentFile=-/etc/upscaling/server.env

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=4G
MemoryHigh=3G
CPUQuota=200%
TasksMax=4096

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/UpscalingByNetwork/server/server_work
ReadWritePaths=/opt/UpscalingByNetwork/server/logs
ReadWritePaths=/opt/UpscalingByNetwork/server/output
ReadWritePaths=/tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/dri rw
DeviceAllow=/dev/nvidia* rw

# System call filtering
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
SystemCallErrorNumber=EPERM

# Capability restrictions
CapabilityBoundingSet=
AmbientCapabilities=

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=upscaling-server

[Install]
WantedBy=multi-user.target

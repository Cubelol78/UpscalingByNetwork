[Unit]
Description=Distributed Upscaling Client
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/path/to/client/linux
ExecStart=/usr/bin/python3 /path/to/client/linux/client_main.py run --host SERVER_IP --port 8765
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%i/.config/upscaling-client /home/%i/.local/share/upscaling-client

[Install]
WantedBy=multi-user.target

# Git LFS configuration for large binary files in assets/
# Install Git LFS: https://git-lfs.github.com/
# After installation, run: git lfs install

# Executables
assets/**/*.exe filter=lfs diff=lfs merge=lfs -text
assets/**/*.dll filter=lfs diff=lfs merge=lfs -text

# FFmpeg binaries (Linux/Mac)
assets/**/ffmpeg filter=lfs diff=lfs merge=lfs -text
assets/**/ffprobe filter=lfs diff=lfs merge=lfs -text

# RealESRGAN binaries
assets/**/realesrgan-ncnn-vulkan filter=lfs diff=lfs merge=lfs -text
assets/**/realesrgan-ncnn-vulkan.exe filter=lfs diff=lfs merge=lfs -text

# Model files (binary)
assets/**/*.bin filter=lfs diff=lfs merge=lfs -text
assets/**/*.param filter=lfs diff=lfs merge=lfs -text

# Keep text files as regular Git objects
assets/**/*.md text
assets/**/*.txt text
assets/**/*.json text
